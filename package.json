{
  "name": "progressrooms-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-environment.mjs dev",
    "build": "next build",
    "start": "node scripts/start-environment.mjs",
    "lint": "next lint",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build:standalone": "next build && node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "start:dev": "node scripts/start-environment.mjs dev",
    "start:uat": "node scripts/start-environment.mjs uat",
    "start:prod": "node scripts/start-environment.mjs prod",
    "test:components": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
